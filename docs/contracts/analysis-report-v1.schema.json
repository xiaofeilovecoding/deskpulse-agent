{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeskPulse Agent AnalysisReport v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "locale",
    "summary",
    "confidence",
    "evidence_ids",
    "limitations",
    "suggestions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[a-zA-Z0-9._:-]+$"
    },
    "locale": {
      "enum": [
        "zh-CN",
        "en"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 700
    },
    "confidence": {
      "enum": [
        "unknown",
        "low",
        "medium",
        "high"
      ]
    },
    "evidence_ids": {
      "type": "array",
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 96,
        "pattern": "^[a-zA-Z0-9._:-]+$"
      }
    },
    "limitations": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      }
    },
    "suggestions": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "reason"
            ],
            "properties": {
              "action": {
                "const": "resample_metrics"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "reason"
            ],
            "properties": {
              "action": {
                "const": "inspect_memory_pressure"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "reason"
            ],
            "properties": {
              "action": {
                "const": "release_deskpulse_buffers"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "reason",
              "target_id"
            ],
            "properties": {
              "action": {
                "const": "retest_target"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              },
              "target_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96,
                "pattern": "^[a-zA-Z0-9._:-]+$"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "reason",
              "volume_id"
            ],
            "properties": {
              "action": {
                "const": "disk_preview"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              },
              "volume_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96,
                "pattern": "^[a-zA-Z0-9._:-]+$"
              }
            }
          }
        ]
      }
    }
  }
}
